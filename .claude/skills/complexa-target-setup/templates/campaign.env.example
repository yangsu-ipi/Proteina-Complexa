# Every campaign-specific value, in one place. Copy to <campaign>/campaign.env and
# edit; the templates that read it should not need editing at all.
#
# If you find yourself changing a template instead of this file, that is a bug in
# the template -- it means something campaign-specific was left baked in.

# --- identity -------------------------------------------------------------
TASK_NAME=CBLN1_5KC5_GLUD2          # generation.task_name; appears in output dir names
CONFIG_NAME=pipeline                # base_config_name; also the rewards_<name>_<shard>.csv prefix
RUN_PREFIX=cbln1_5kc5_glud2_esmc_esmfold2

# --- where things are -----------------------------------------------------
CAMPAIGN_DIR="${CAMPAIGN_DIR:-/data/$USER/CBLN1/proteina_complexa_5kc5_esmc_esmfold2}"
COMPLEXA_REPO="${COMPLEXA_REPO:-/data/shared/tools/Proteina-Complexa}"
CONDA_SH="${CONDA_SH:-/data/shared/miniforge3/etc/profile.d/conda.sh}"
CONDA_ENV="${CONDA_ENV:-proteina-complexa}"

# --- target ---------------------------------------------------------------
TARGET_PDB=data/5KC5_chainA_58-193_clean.pdb
TARGET_CHAIN=A
TARGET_INPUT=A58-193

# --- campaign-specific preparation ----------------------------------------
# Run in order before validation, from the package root. Anything this package
# needs built before a run: MSAs, extracted targets, derived inputs. Leave empty
# if there is nothing to do.
PREPARE_STEPS=(
  scripts/prepare_target_msa.py
)

# --- shape of the two run kinds -------------------------------------------
# SEEDS is split over SHARDS; beam width then expands each seed into RAW total.
# KEEP is per shard (trim_shards.py); EXPECT is the total after trimming.
SHARDS=2

SMOKE_SEEDS=2
SMOKE_RAW=16
SMOKE_KEEP=4
SMOKE_EXPECT=8

PRODUCTION_SEEDS=64
PRODUCTION_RAW=512
PRODUCTION_KEEP=250
PRODUCTION_EXPECT=500

# --- GPU budget -----------------------------------------------------------
# JAX preallocates a fraction of every visible card, and BOTH stages run it --
# generation through the AF2 reward, evaluation through colabdesign refolding.
# The two have opposite profiles, so they get different fractions.
#
#   generation: torch (the diffusion model) peaked at 3.12 GiB measured; JAX is
#     the dominant consumer, so give it most of the card.
#   evaluation: torch (ESMC + ESMFold2) peaked at 38.11 GiB measured; JAX needs
#     much less, and the ProteinMPNN SUBPROCESS needs ~500 MiB of its own on top.
#     At 0.5 there were 443 MiB free and MPNN could not start.
#
# Measured on 2x A100 80 GB. On a smaller card, lower both and lower batch_size.
# These three take an environment override, so a fraction can be tried for one run
# without editing the file -- `XLA_MEM_FRACTION_EVALUATE=0.25 sbatch ...`. Identity
# and target values above are deliberately plain assignments: overriding those by
# accident would silently run a different campaign.
XLA_MEM_FRACTION_GENERATE="${XLA_MEM_FRACTION_GENERATE:-0.7}"
XLA_MEM_FRACTION_EVALUATE="${XLA_MEM_FRACTION_EVALUATE:-0.3}"
MIN_VRAM_GB="${MIN_VRAM_GB:-40}"

# --- what this campaign's results must contain ----------------------------
# Passed to verify_run_outputs.py --require-column. Name what you depend on; a
# campaign using plain ESMFold would name different columns, or none.
REQUIRE_COLUMNS=(
  self_esm_pseudo_perplexity
  self_apo_scRMSD_ca_esmfold2
  redesign_model
)
REQUIRE_HF_REPOS=(
  biohub/ESMFold2-Experimental-Cutoff2025
  biohub/ESMFold2-Experimental-Fast-Cutoff2025
)
REDESIGN_MODEL=soluble_mpnn
